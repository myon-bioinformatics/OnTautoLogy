    "name": "ピカチュウ",
    "claims": {
      "habitat": "森にすむ。",
      "forest-group": "仲間と群れで暮らす姿が見られる。",
      "cheek-sacs": "頬に電気袋がある。",
      "paired-small": "顔の左右に一つずつ、小さな袋が並ぶ。",
      "store": "体に電気を蓄える習性がある。",
      "store-in-cheeks": "その貯蔵場所が頬の袋だ。",
      "sac-softness": "強い電気を作れる個体ほど、その袋は柔らかく伸びやすい。",
      "touch": "頬の袋に触れると、電気でしびれる。",
      "sleep-make": "眠っている間に頬で発電する。",
      "night-store": "夜中に眠りながら電気を蓄えるらしい。",
      "sleep-discharge": "寝ぼけて電気を放つこともある。",
      "sleep-deprived": "睡眠が足りないと、弱い電気しか出せない。",
      "stress": "ときどき思い切り放電しないとストレスを感じる。",
      "full-power": "全力の放電は雷に匹敵する。",
      "pinch": "危機に陥ると放電する。",
      "anger": "怒ったときには蓄えを一気に放つ。",
      "warning": "頬から小さく火花を散らすのは、相手を警戒している合図だ。",
      "survey-with-tail": "しっぽを立てて辺りの気配を探る。",
      "bite-if-pulled": "しっぽをむやみに引くと、かみつく。",
      "lightning-while-surveying": "辺りを探っている最中に、しっぽに雷が落ちることもある。",
      "group-lightning": "何匹も集まると周囲に強い電気がたまり、落雷を招くことがあるという。",
      "forest-lightning": "群れのすむ森では雷が頻繁に落ちて危険だ。",
      "berries": "硬い木の実を食べるときは電撃で焼く。",
      "soften": "焼くと木の実が柔らかくなることを知っている。",
      "novelty": "初めて見る物には電撃を試す。",
      "charred": "黒焦げの木の実は、電撃の加減を誤った跡だ。",
      "greeting": "仲間との挨拶では、しっぽを合わせて電気をやり取りする。",
      "revive": "弱った仲間には電気を送って元気を分けることがある。",
