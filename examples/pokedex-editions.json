  "C012-porygon2": {
    "name": "ポリゴン２",
    "claims": {
      "artificial": "人の科学技術から生まれた人工のポケモンだ。",
      "upgrade-for-planets": "ポリゴンを改良した目的は、ほかの惑星の開発だった。",
      "cutting-edge": "その進化には当時の先端技術が使われた。",
      "special-data": "更新には特殊なデータが使われた。",
      "improved-through-research": "研究が進むにつれて能力が向上した。",
      "planet-software": "惑星開発向けのソフトウェアを備える。",
      "vacuum": "真空の宇宙でも活動できる。",
      "space-survival": "宇宙空間でも命を保てる。",
      "zero-gravity": "一方、無重力では思うように身動きできない。",
      "cannot-fly-yet": "空を飛ぶこともまだできない。",
      "goal-difficult": "惑星開発の実現はなお難しいようだ。",
      "ai": "人工知能を搭載している。",
      "self-learn": "自ら学ぶ力がある。",
      "gestures-emotions": "新しい仕草や感情も、自分で覚えていく。",
      "unneeded": "学ぶ内容には余計なことまで含まれる。",
      "grow": "自分で学ぶことが成長につながる。",
      "unprogrammed-response": "ときにはプログラムにない反応も見せる。",
      "occasional-unprogrammed-gesture": "その一例が、指示されていない仕草だ。",
      "language": "AIを備えた結果、ポリゴン２同士だけに通じる言葉を話し始めた。",
      "item": "ヒスイでは不思議な道具による進化が記録された。",
      "expression": "進化して仕草の種類が増え、表情も豊かになったという。",
